# SwasthyaSetu Backend Environment Configuration
# Copy this file to .env for local development (do NOT commit .env)

NODE_ENV=development
PORT=4000

# AWS Configuration
AWS_REGION=ap-south-1

# Amazon DynamoDB
DYNAMODB_TABLE_NAME=swasthyasetu-main-table

# Amazon S3 (Private Medical Documents)
S3_BUCKET_NAME=swasthyasetu-medical-records-bucket

# Amazon Cognito
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon Bedrock
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_GUARDRAIL_ID=xxxxxxxxxxxx
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Local Development Adapter Flag
# Set to 'true' to use in-memory seeded repositories and mock AWS adapters.
# Mock Bearer tokens and unsigned JWT decoding are allowed only when this is true
# AND NODE_ENV is not production. Production must use API Gateway Cognito authorizer claims.
# This backend does not verify JWT signatures itself.
USE_MOCK_AWS=true

# When USE_MOCK_AWS=false, placeholder values (dummy, xxxxxxxx) are rejected.
# Set real resource identifiers from your AWS account. Do not deploy until approved.
# Required: AWS_REGION, DYNAMODB_TABLE_NAME, S3_BUCKET_NAME,
# COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID, BEDROCK_MODEL_ID.
# BEDROCK_GUARDRAIL_ID is optional until Guardrails are provisioned.
